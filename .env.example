# ===== 数据库 =====
# 开发用 SQLite，生产改 PostgreSQL：
#   postgresql+psycopg://user:pass@host:5432/ilink_bot
DATABASE_URL=sqlite:///./ilink_bot.db

# ===== AI（OpenAI 兼容格式，可填 DeepSeek / 智谱 / 通义等）=====
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== iLink Bot 官方 API =====
ILINK_BASE_URL=https://ilinkai.weixin.qq.com

# ===== 长轮询超时（秒）=====
# iLink 服务端默认 hold ~35s，客户端建议 40s+
LONG_POLL_TIMEOUT=40

# ===== 发送间隔（毫秒）=====
# 防止触发 ret=-2 限流，两条消息之间最小间隔
SEND_INTERVAL_MS=500
